---
import { getEntry, render } from 'astro:content';
import { site } from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import TownGrid from '../components/TownGrid.astro';
import QuoteForm from '../components/QuoteForm.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout seoTitle={d.seoTitle} description={d.description} pageType="home">
  <section class="hero has-form">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{d.title}</h1>
        <p>{d.tagline ?? d.description}</p>
        <div class="cta">
          <a class="cta-primary" href={`tel:${site.business.phoneRaw}`}>Call {site.business.phone}</a>
        </div>
      </div>
      <QuoteForm />
    </div>
  </section>

  {d.hero && (
    <div class="wrap">
      <figure class="page-hero">
        <img src={`/images/${d.hero}`} alt={d.heroAlt ?? d.title} width="1120" height="560" loading="eager" fetchpriority="high" />
        {d.heroCaption && <figcaption>{d.heroCaption}</figcaption>}
      </figure>
    </div>
  )}

  <div class="wrap">
    <article class="prose"><Content /></article>
  </div>

  <section class="section alt">
    <div class="wrap">
      <h2>Our {site.trade.nounPlural} in {site.location.city}</h2>
      <ServiceGrid />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Areas we serve around {site.location.county}</h2>
      <TownGrid />
    </div>
  </section>
</BaseLayout>
